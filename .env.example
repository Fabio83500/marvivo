# Configuration du formulaire de contact (src/pages/api/contact.js).
# Copiez ce fichier en `.env.local` et remplissez les valeurs.
# Ne commitez JAMAIS le fichier contenant le vrai mot de passe.

# Serveur d'envoi de la boîte mail du club (exemple pour une adresse Orange)
SMTP_HOST=smtp.orange.fr
SMTP_PORT=465
SMTP_USER=asmarvivo@orange.fr
SMTP_PASSWORD=

# Adresse qui reçoit les messages du formulaire
CONTACT_EMAIL_TO=asmarvivo@orange.fr
