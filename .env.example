# Configuration du formulaire de contact (src/pages/api/contact.js).
# Copiez ce fichier en `.env.local` et remplissez les valeurs.
# En production, saisissez ces mêmes variables dans les réglages de l'hébergeur.
# Ne commitez JAMAIS le fichier contenant la vraie clé.

# Envoi via le SMTP de Resend (https://resend.com/docs/send-with-smtp)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
# Clé API Resend (re_...), avec l'accès « Sending access » limité au domaine d'envoi
SMTP_PASSWORD=

# Adresse d'expédition : doit appartenir à un domaine vérifié dans Resend
SMTP_FROM=formulaire@domaine-verifie.fr

# Adresse qui reçoit les messages du formulaire
CONTACT_EMAIL_TO=asmarvivo@orange.fr
